{
	"name": "VIZonator",
	"version": "0.71",
	"description": "VIZ Extension! Adds web3 provider to pages, available variable: vizonator.",
	"permissions": ["alarms","activeTab","tabs","scripting","storage","offscreen"],
	"host_permissions": ["http://*/*","https://*/*"],
	"background": {
		"service_worker": "background.js"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "VIZonator",
		"default_icon": {
			"16": "images/icon16.png",
			"32": "images/icon32.png",
			"48": "images/icon48.png",
			"128": "images/icon128.png"
		}
	},
	"icons": {
		"16": "images/icon16.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png",
		"128": "images/icon128.png"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"manifest_version": 3
}