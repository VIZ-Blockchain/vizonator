{
	"name": "VIZonator",
	"version": "0.73",
	"description": "VIZ Extension! Adds web3 provider to pages, available variable: vizonator.",
	"permissions": ["alarms","activeTab","tabs","scripting","storage"],
	"host_permissions": ["http://*/*","https://*/*"],
	"background": {
		"scripts": ["viz.min.js","ltmp_arr.js","ltmp_en.js","ltmp_ru.js","pm_ops.js","secp256k1.js","memo_crypto.js","background.js"]
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "VIZonator",
		"default_icon": {
			"16": "images/icon16.png",
			"32": "images/icon32.png",
			"48": "images/icon48.png",
			"128": "images/icon128.png"
		}
	},
	"icons": {
		"16": "images/icon16.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png",
		"128": "images/icon128.png"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "{385b06f7-9ae9-44a9-abcf-db356d51b64f}",
			"strict_min_version": "109.0"
		}
	},
	"manifest_version": 3
}
